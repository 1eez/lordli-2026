---
import Shell from '../components/Shell.astro';
import { readFileSync } from 'node:fs';
const lorenzArtwork = readFileSync('public/media/lorenz-attractor.svg', 'utf8');
import { documents, resources } from '../lib/content';
const product = documents.filter(d => d.category === '产品理念').sort((a,b) => a.slug.localeCompare(b.slug));
const project = documents.filter(d => d.category === '项目管理');
const code = documents.filter(d => d.category === '编程');
const picks = [
  documents.find(d => d.slug.endsWith('1-customer'))!,
  documents.find(d => d.slug.endsWith('5-ingenuity'))!,
  documents.find(d => d.slug.endsWith('how-to-define-priority'))!,
];
---
<Shell>
  <main id="main" data-pagefind-body>
    <section class="hero section-pad">
      <div class="hero-topline"><span class="eyebrow">THE PERSONAL SPACE OF lord Li</span><span class="edition">THINK / BUILD / SHARE</span></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1><span data-zh="让想法" data-en="Ideas made">让想法</span><br/><span class="hero-last" data-zh="真实发生" data-en="real">真实发生</span><span class="title-asterisk" aria-hidden="true">✳</span></h1>
          <div class="hero-bottom"><span class="hero-index">01 — 06</span><div><p class="hero-description" data-zh="在产品、项目与代码之间，\n把思考变成值得创造的事物。" data-en="At the intersection of product, projects and code,\nturning thought into things worth building.">在产品、项目与代码之间，<br/>把思考变成值得创造的事物。</p><a href="#work" class="pill-link"><span data-zh="探索我的作品" data-en="Explore my work">探索我的作品</span><span class="round-arrow">↗</span></a></div></div>
        </div>
        <div class="hero-art" aria-label="朱橙色洛伦兹吸引子：由非线性动力系统轨迹构成的双翼结构" role="img">
          <div class="art-corner corner-tl"></div><div class="art-corner corner-tr"></div><div class="art-corner corner-bl"></div><div class="art-corner corner-br"></div>
          <span class="art-label">LORENZ ATTRACTOR</span>
          <div class="sculpture-wrap" set:html={lorenzArtwork} />
          <span class="art-coordinate">σ = 10 · ρ = 28 · β = 8/3</span><span class="art-plus">+</span>
        </div>
      </div>
      <div class="hero-foot"><span>PRODUCT & PROJECT MANAGER</span><a href="#work" data-zh="向下探索 ↓" data-en="SCROLL TO EXPLORE ↓">向下探索 ↓</a></div>
    </section>

    <section id="work" class="work-section section-pad">
      <div class="section-heading reveal"><div><p class="eyebrow"><span class="orange-dot"></span> 01 / SELECTED WORK</p><h2 data-zh="一些想法，已经发生。" data-en="Thoughts, turned into things.">一些想法，已经发生。</h2></div><span class="section-side" data-zh="从一个念头，到一个可以打开的产品。" data-en="From a first thought to a product you can open.">从一个念头，到一个可以打开的产品。</span></div>
      <div class="work-grid">
        <article class="work-item reveal">
          <button class="work-board purine-board" data-qr="/media/images/qrcode3.jpg" data-title="Purine Query Tool" aria-label="查看 Purine Query Tool 小程序码">
            <span class="board-top">01 / WECHAT MINI PROGRAM</span>
            <div class="purine-art"><span class="purine-letter">P<span class="letter-dot">.</span></span><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span><span class="orbit-node"></span></div>
            <div class="board-bottom"><span>PURINE<br/>QUERY TOOL</span><span class="board-open">↗</span></div>
          </button>
          <div class="work-caption"><div><h3>Purine Query Tool</h3><p data-zh="嘌呤查询工具 · 微信小程序" data-en="Purine query tool · WeChat mini program">嘌呤查询工具 · 微信小程序</p></div><button class="qr-link" data-qr="/media/images/qrcode3.jpg" data-title="Purine Query Tool" data-zh="扫码体验 ↗" data-en="Open QR ↗">扫码体验 ↗</button></div>
        </article>
        <article class="work-item work-item-offset reveal">
          <button class="work-board boyfriend-board" data-qr="/media/images/qrcode1.jpg" data-title="Choosing Boyfriend" aria-label="查看 Choosing Boyfriend 小程序码">
            <span class="board-top">02 / WECHAT MINI PROGRAM</span>
            <div class="heart-art" aria-hidden="true"><svg viewBox="0 0 360 300" fill="none"><path d="M180 252 54 135C-26 53 92-30 180 71 268-30 386 53 306 135Z" fill="#242126"/><path d="m180 252 6-179" stroke="#d7cbe6" stroke-width="1.2"/><path d="m54 135 252 0M82 51l98 201L278 51" stroke="#d7cbe6" stroke-width="1.2"/></svg><span class="heart-spark">✳</span></div>
            <div class="board-bottom"><span>CHOOSING<br/>BOYFRIEND</span><span class="board-open">↗</span></div>
          </button>
          <div class="work-caption"><div><h3>Choosing Boyfriend</h3><p data-zh="个人作品 · 微信小程序" data-en="Personal project · WeChat mini program">个人作品 · 微信小程序</p></div><button class="qr-link" data-qr="/media/images/qrcode1.jpg" data-title="Choosing Boyfriend" data-zh="扫码体验 ↗" data-en="Open QR ↗">扫码体验 ↗</button></div>
        </article>
      </div>
    </section>

    <section id="about" class="about-section section-pad">
      <div class="about-label reveal"><p class="eyebrow"><span class="orange-dot"></span> 02 / A LITTLE ABOUT ME</p><div class="portrait-wrap"><img src="/media/images/myphoto.jpg" width="300" height="300" alt="lord Li 的个人照片" loading="lazy"/><span>lord Li / PORTRAIT</span></div></div>
      <div class="about-copy reveal"><h2><span data-zh="理解复杂，" data-en="Understand complexity.">理解复杂，</span><br/><span class="muted" data-zh="创造清晰。" data-en="Create clarity.">创造清晰。</span></h2><p class="about-intro" data-zh="我是一名产品与项目经理，长期在金融科技、互联网产品和技术实践的交汇处工作。" data-en="I’m a product and project manager, working at the intersection of financial technology, internet products and hands-on technology.">我是一名产品与项目经理，长期在金融科技、互联网产品和技术实践的交汇处工作。</p><p class="about-detail" data-zh="拥有近 20 年金融科技从业经验、12 年 IT 项目管理经验及 8 年互联网产品设计经验。PMP、PRINCE2 认证，阿尔伯塔大学金融管理硕士。" data-en="Almost 20 years in financial technology, 12 years in IT project management and 8 years in internet product design. PMP and PRINCE2 certified. Master of Financial Management, University of Alberta.">拥有近 20 年金融科技从业经验、12 年 IT 项目管理经验及 8 年互联网产品设计经验。PMP、PRINCE2 认证，阿尔伯塔大学金融管理硕士。</p><span class="archive-caption" data-zh="经历信息沿用旧站资料" data-en="Experience figures retained from the original site">经历信息沿用旧站资料</span><div class="about-links"><a href="/read/index/" class="text-link" data-zh="完整个人简介 ↗" data-en="More about me ↗">完整个人简介 ↗</a><a href="/read/about/skills/" class="text-link" data-zh="技能与能力 ↗" data-en="Skills & capabilities ↗">技能与能力 ↗</a></div></div>
    </section>

    <section id="thinking" class="thinking-section section-pad">
      <div class="section-heading reveal"><div><p class="eyebrow"><span class="orange-dot"></span> 03 / NOTES & PERSPECTIVES</p><h2 data-zh="做事，也思考做事。" data-en="Doing. And thinking about doing.">做事，也思考做事。</h2></div><span class="section-side" data-zh="产品理念 / 项目管理 / 编程实践" data-en="PRODUCT / PROJECTS / CODE">产品理念 / 项目管理 / 编程实践</span></div>
      <div class="editorial-feature reveal"><div class="feature-graphic" aria-hidden="true"><span>THINK<br/><i>THEN</i><br/>BUILD.</span><div class="graphic-asterisk">✳</div><span class="graphic-foot">GOOD QUESTIONS. BETTER PRODUCTS.</span></div><div class="feature-copy"><p class="eyebrow" data-zh="产品理念 · 10 篇文章" data-en="PRODUCT THINKING · 10 ARTICLES">产品理念 · 10 篇文章</p><h3 data-zh="好产品，\n始于好问题。" data-en="Better questions.\nBetter products.">好产品，<br/>始于好问题。</h3><p data-zh="从用户、定位与需求出发，探索时机、匠心、合作和商业。沿着现有产品理念系列，重新理解产品背后的判断。" data-en="From users, positioning and needs to timing, craft, collaboration and business. Explore the thinking behind product decisions.">从用户、定位与需求出发，探索时机、匠心、合作和商业。沿着现有产品理念系列，重新理解产品背后的判断。</p><a href="/read/product/0-introduction/" class="text-link" data-zh="从系列介绍读起 ↗" data-en="Start with the introduction ↗">从系列介绍读起 ↗</a><details class="article-directory"><summary data-zh="查看全部 10 篇" data-en="All 10 articles">查看全部 10 篇</summary><ul>{product.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div></div>
      <div class="article-picks">{picks.map((d,i)=><a class="article-row reveal" href={`/read/${d.slug}/`}><span class="article-number">0{i+1}</span><span class="article-category">{d.category}</span><h3>{d.title}</h3><span class="row-arrow">↗</span></a>)}</div>
      <div class="knowledge-grid">
        <div id="management" class="knowledge-column reveal"><div class="knowledge-heading"><span class="eyebrow">04 / PROJECT MANAGEMENT</span><span>15</span></div><h3 data-zh="让复杂的事，有序发生。" data-en="Make complex things happen.">让复杂的事，有序发生。</h3><p data-zh="关于价值、沟通、风险、协作与交付的实践记录。" data-en="Notes on value, communication, risk, collaboration and delivery.">关于价值、沟通、风险、协作与交付的实践记录。</p><details class="article-directory"><summary data-zh="探索项目管理文章" data-en="Explore 15 articles">探索项目管理文章</summary><ul>{project.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div>
        <div id="programming" class="knowledge-column reveal"><div class="knowledge-heading"><span class="eyebrow">05 / PROGRAMMING</span><span>06</span></div><h3 data-zh="思考之后，动手实现。" data-en="Think it through. Build it out.">思考之后，动手实现。</h3><p data-zh="Python、R 与数据分析，把想法写进代码。" data-en="Python, R and data analysis. Thinking, expressed in code.">Python、R 与数据分析，把想法写进代码。</p><details class="article-directory"><summary data-zh="探索编程文章" data-en="Explore 6 articles">探索编程文章</summary><ul>{code.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div>
      </div>
    </section>

    <section id="resources" class="resources-section section-pad">
      <div class="resource-art reveal" aria-hidden="true"><span class="resource-mark">↗</span><span class="eyebrow">OPEN TO EXPLORE.</span></div>
      <div class="resource-copy reveal"><p class="eyebrow">06 / OPEN RESOURCES</p><h2 data-zh="知识，\n也可以共享。" data-en="Knowledge,\nmade shareable.">知识，<br/>也可以共享。</h2><p data-zh="文章、素材与结构化内容，留给好奇的人，也留给创造中的程序。首个专题：乐理与听音。" data-en="Articles, materials and structured content. For curious people and the things they build. First collection: music theory and ear training.">文章、素材与结构化内容，留给好奇的人，也留给创造中的程序。首个专题：乐理与听音。</p><div class="resource-links"><a class="text-link" href={`/read/${resources[0].slug}/`} data-zh="读一篇乐理文章 ↗" data-en="Read a music theory article ↗">读一篇乐理文章 ↗</a><a class="text-link" href="/data/v1/music-theory/index.json" data-zh="浏览数据索引 ↗" data-en="Explore the data index ↗">浏览数据索引 ↗</a></div><details class="article-directory"><summary data-zh="全部 7 篇乐理文章" data-en="All 7 music theory articles">全部 7 篇乐理文章</summary><ul>{resources.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div>
    </section>

    <section class="contact-section section-pad"><div class="contact-top reveal"><p class="eyebrow">A CONVERSATION STARTS SOMETHING.</p><a href="https://github.com/1eez" target="_blank" rel="noreferrer">GITHUB ↗</a></div><a class="contact-title reveal" href="mailto:cnpro@163.com"><span data-zh="聊聊新的可能。" data-en="Let’s talk possibilities.">聊聊新的可能。</span><span class="contact-arrow">↗</span></a><div class="contact-bottom"><a href="mailto:cnpro@163.com">CNPRO@163.COM</a><button class="qr-link" data-qr="/media/images/myqrcode.png" data-title="WeChat / 微信" data-zh="微信联系 ↗" data-en="Connect on WeChat ↗">微信联系 ↗</button><span data-zh="保持好奇，持续创造。" data-en="Stay curious. Keep creating.">保持好奇，持续创造。</span></div></section>
  </main>
</Shell>
