---
import Shell from '../components/Shell.astro';
import WorkCard from '../components/WorkCard.astro';
import { works, workCategories } from '../data/works';
import { readFileSync } from 'node:fs';
const lorenzArtwork = readFileSync('public/media/lorenz-attractor.svg', 'utf8');
import { documents, resources } from '../lib/content';
const product = documents.filter(d => d.category === '产品理念').sort((a,b) => a.slug.localeCompare(b.slug));
const project = documents.filter(d => d.category === '项目管理');
const code = documents.filter(d => d.category === '编程');
const picks = [
  documents.find(d => d.slug.endsWith('1-customer'))!,
  documents.find(d => d.slug.endsWith('5-ingenuity'))!,
  documents.find(d => d.slug.endsWith('how-to-define-priority'))!,
];
---
<Shell>
  <main id="main" data-pagefind-body>
    <section class="hero section-pad">
      <div class="hero-topline"><span class="eyebrow">THE PERSONAL SPACE OF Lord Li</span><span class="edition">THINK / BUILD / SHARE</span></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1><span data-zh="让想法" data-en="Ideas made">让想法</span><br/><span class="hero-last" data-zh="真实发生" data-en="real">真实发生</span><span class="title-asterisk" aria-hidden="true"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M2 12h20M5 5l14 14M5 19L19 5" /></svg></span></h1>
          <div class="hero-bottom"><span class="hero-index">01 — 06</span><div><p class="hero-description" data-zh="在产品、项目与代码之间，\n把思考变成值得创造的事物。" data-en="At the intersection of product, projects and code,\nturning thought into things worth building.">在产品、项目与代码之间，<br/>把思考变成值得创造的事物。</p><a href="#work" class="pill-link"><span data-zh="探索我的作品" data-en="Explore my work">探索我的作品</span><span class="round-arrow">↗</span></a></div></div>
        </div>
        <div class="hero-visual">
        <div class="hero-art" aria-label="洛伦兹吸引子交互图形" role="group">
          <div class="art-corner corner-tl"></div><div class="art-corner corner-tr"></div><div class="art-corner corner-bl"></div><div class="art-corner corner-br"></div>
          <a class="art-label" href="https://en.wikipedia.org/wiki/Lorenz_system" target="_blank" rel="noopener noreferrer" aria-label="在维基百科了解洛伦兹系统（新窗口打开）">LORENZ ATTRACTOR ↗</a>
          <div class="sculpture-wrap" set:html={lorenzArtwork} />
          <span class="art-coordinate">σ = 10 · ρ = 28 · β = 8/3</span><span class="art-plus">+</span>
        </div>
        <form class="lorenz-controls" hidden aria-label="洛伦兹参数调节" data-pagefind-ignore>
          <div class="lorenz-control-heading"><span data-zh="探索混沌" data-en="EXPLORE CHAOS">探索混沌</span><button type="reset" data-zh="重置 ↺" data-en="Reset ↺">重置 ↺</button></div>
          <div class="lorenz-sliders">
            <label for="lorenz-sigma"><span>σ <output for="lorenz-sigma">10</output></span><input id="lorenz-sigma" name="sigma" type="range" min="1" max="30" step="0.1" value="10" aria-label="Sigma" /></label>
            <label for="lorenz-rho"><span>ρ <output for="lorenz-rho">28</output></span><input id="lorenz-rho" name="rho" type="range" min="0" max="100" step="0.5" value="28" aria-label="Rho" /></label>
            <label for="lorenz-beta"><span>β <output for="lorenz-beta">8/3</output></span><input id="lorenz-beta" name="beta" type="range" min="0.5" max="6" step="any" value={8 / 3} aria-label="Beta" /></label>
          </div>
          <p class="lorenz-status" role="status" data-zh="拖动参数，观察轨迹如何变化。" data-en="Drag a parameter to explore the trajectory.">拖动参数，观察轨迹如何变化。</p>
        </form>
        </div>
      </div>
      <div class="hero-foot"><span>PRODUCT & PROJECT MANAGER</span><a href="#work" data-zh="向下探索 ↓" data-en="SCROLL TO EXPLORE ↓">向下探索 ↓</a></div>
    </section>

    <section id="work" class="work-section section-pad">
      <div class="section-heading reveal"><div><p class="eyebrow"><span class="orange-dot"></span> 01 / SELECTED WORK</p><h2 data-zh="一些想法，已经发生。" data-en="Thoughts, turned into things.">一些想法，已经发生。</h2></div><a href="/work/" class="collection-cta"><span data-zh="浏览全部作品" data-en="View all works">浏览全部作品</span><span class="collection-count">{String(works.length).padStart(2, '0')}</span><span class="collection-arrow" aria-hidden="true">↗</span></a></div>
      <div class="portfolio-overview"><span data-zh={`首页精选 ${works.filter(work => work.featured).length} 件 / 完整作品 ${works.length} 件`} data-en={`${works.filter(work => work.featured).length} SELECTED / ${works.length} IN THE COLLECTION`}>首页精选 {works.filter(work => work.featured).length} 件 / 完整作品 {works.length} 件</span><nav aria-label="浏览全部作品分类">{workCategories.map(category => { const count = String(works.filter(work => work.category === category.id).length).padStart(2, '0'); return <a href={`/work/#${category.id}`} data-zh={`${category.title} ${count}`} data-en={`${category.englishTitle} ${count}`}>{category.title} {count}</a>; })}</nav></div>
      <div class="homepage-portfolio">
        {works.filter(work => work.featured).map((work, index) => <WorkCard work={work} number={works.indexOf(work) + 1} featured={index === 0} />)}
      </div>
      <a class="portfolio-more" href="/work/"><div><span class="eyebrow">THE COMPLETE COLLECTION / {String(works.length).padStart(2, '0')}</span><strong data-zh={`还有 ${works.length - works.filter(work => work.featured).length} 件作品，继续探索。`} data-en={`${works.length - works.filter(work => work.featured).length} more works. Keep exploring.`}>还有 {works.length - works.filter(work => work.featured).length} 件作品，继续探索。</strong></div><span class="portfolio-more-action"><span data-zh="进入完整作品集" data-en="Explore the collection">进入完整作品集</span><span class="portfolio-more-arrow" aria-hidden="true">↗</span></span></a>
    </section>

    <section id="about" class="about-section section-pad">
      <div class="about-label reveal"><p class="eyebrow"><span class="orange-dot"></span> 02 / A LITTLE ABOUT ME</p><div class="portrait-wrap"><img src="/media/images/myphoto-transparent.png" width="300" height="300" alt="Lord Li 的个人照片" loading="lazy"/><span>Lord Li / PORTRAIT</span></div></div>
      <div class="about-copy reveal"><h2><span data-zh="理解 AI，" data-en="Understand AI.">理解 AI，</span><br/><span class="muted" data-zh="让想法落地。" data-en="Make ideas happen.">让想法落地。</span></h2><p class="about-intro" data-zh="我关注 AI 的理解与应用，将模型能力与真实需求连接起来，探索更有效的人机协作、产品创造与工作流程。" data-en="I focus on understanding and applying AI, connecting model capabilities with real needs to improve human–AI collaboration, product creation and everyday workflows.">我关注 AI 的理解与应用，将模型能力与真实需求连接起来，探索更有效的人机协作、产品创造与工作流程。</p><p class="about-detail" data-zh="作为产品经理与项目经理，结合长期金融科技、产品设计与项目管理经验，从问题定义、原型验证到交付复盘，让 AI 的应用有目标、有边界、有结果。PMP、PRINCE2 认证，阿尔伯塔大学金融管理硕士。" data-en="As a product and project manager with extensive experience in financial technology, product design and project management, I bring clear goals, boundaries and evaluation to AI applications, from problem definition and prototyping to delivery and review. PMP and PRINCE2 certified. Master of Financial Management, University of Alberta.">作为产品经理与项目经理，结合长期金融科技、产品设计与项目管理经验，从问题定义、原型验证到交付复盘，让 AI 的应用有目标、有边界、有结果。PMP、PRINCE2 认证，阿尔伯塔大学金融管理硕士。</p><div class="about-links"><a href="/read/index/" class="text-link" data-zh="完整个人简介 ↗" data-en="More about me ↗">完整个人简介 ↗</a><a href="/read/about/skills/" class="text-link" data-zh="技能与能力 ↗" data-en="Skills & capabilities ↗">技能与能力 ↗</a></div></div>
    </section>

    <section id="thinking" class="thinking-section section-pad">
      <div class="section-heading reveal"><div><p class="eyebrow"><span class="orange-dot"></span> 03 / NOTES & PERSPECTIVES</p><h2 data-zh="做事，也思考做事。" data-en="Doing. And thinking about doing.">做事，也思考做事。</h2></div><span class="section-side" data-zh="产品理念 / 项目管理 / 编程实践" data-en="PRODUCT / PROJECTS / CODE">产品理念 / 项目管理 / 编程实践</span></div>
      <div class="editorial-feature reveal"><div class="feature-graphic" aria-hidden="true"><span>THINK<br/><i>THEN</i><br/>BUILD.</span><div class="graphic-asterisk"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M2 12h20M5 5l14 14M5 19L19 5" /></svg></div><span class="graphic-foot">GOOD QUESTIONS. BETTER PRODUCTS.</span></div><div class="feature-copy"><p class="eyebrow" data-zh="产品理念 · 10 篇文章" data-en="PRODUCT THINKING · 10 ARTICLES">产品理念 · 10 篇文章</p><h3 data-zh="好产品，\n始于好问题。" data-en="Better questions.\nBetter products.">好产品，<br/>始于好问题。</h3><p data-zh="从用户、定位与需求出发，探索时机、匠心、合作和商业。沿着现有产品理念系列，重新理解产品背后的判断。" data-en="From users, positioning and needs to timing, craft, collaboration and business. Explore the thinking behind product decisions.">从用户、定位与需求出发，探索时机、匠心、合作和商业。沿着现有产品理念系列，重新理解产品背后的判断。</p><a href="/read/product/0-introduction/" class="text-link" data-zh="从系列介绍读起 ↗" data-en="Start with the introduction ↗">从系列介绍读起 ↗</a><details class="article-directory"><summary data-zh="查看全部 10 篇" data-en="All 10 articles">查看全部 10 篇</summary><ul>{product.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div></div>
      <div class="article-picks">{picks.map((d,i)=><a class="article-row reveal" href={`/read/${d.slug}/`}><span class="article-number">0{i+1}</span><span class="article-category">{d.category}</span><h3>{d.title}</h3><span class="row-arrow">↗</span></a>)}</div>
      <div class="knowledge-grid">
        <div id="management" class="knowledge-column reveal"><div class="knowledge-heading"><span class="eyebrow">04 / PROJECT MANAGEMENT</span><span>15</span></div><h3 data-zh="让复杂的事，有序发生。" data-en="Make complex things happen.">让复杂的事，有序发生。</h3><p data-zh="关于价值、沟通、风险、协作与交付的实践记录。" data-en="Notes on value, communication, risk, collaboration and delivery.">关于价值、沟通、风险、协作与交付的实践记录。</p><details class="article-directory"><summary data-zh="探索项目管理文章" data-en="Explore 15 articles">探索项目管理文章</summary><ul>{project.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div>
        <div id="programming" class="knowledge-column reveal"><div class="knowledge-heading"><span class="eyebrow">05 / PROGRAMMING</span><span>06</span></div><h3 data-zh="思考之后，动手实现。" data-en="Think it through. Build it out.">思考之后，动手实现。</h3><p data-zh="Python、R 与数据分析，把想法写进代码。" data-en="Python, R and data analysis. Thinking, expressed in code.">Python、R 与数据分析，把想法写进代码。</p><details class="article-directory"><summary data-zh="探索编程文章" data-en="Explore 6 articles">探索编程文章</summary><ul>{code.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div>
      </div>
    </section>

    <section id="resources" class="resources-section section-pad">
      <div class="resource-art reveal" aria-hidden="true"><span class="resource-mark">↗</span><span class="eyebrow">OPEN TO EXPLORE.</span></div>
      <div class="resource-copy reveal"><p class="eyebrow">06 / OPEN RESOURCES</p><h2 data-zh="知识，\n也可以共享。" data-en="Knowledge,\nmade shareable.">知识，<br/>也可以共享。</h2><p data-zh="文章、素材与结构化内容，留给好奇的人，也留给创造中的程序。首个专题：乐理与听音。" data-en="Articles, materials and structured content. For curious people and the things they build. First collection: music theory and ear training.">文章、素材与结构化内容，留给好奇的人，也留给创造中的程序。首个专题：乐理与听音。</p><div class="resource-links"><a class="text-link" href={`/read/${resources[0].slug}/`} data-zh="读一篇乐理文章 ↗" data-en="Read a music theory article ↗">读一篇乐理文章 ↗</a><a class="text-link" href="/data/v1/music-theory/index.json" data-zh="浏览数据索引 ↗" data-en="Explore the data index ↗">浏览数据索引 ↗</a></div><details class="article-directory"><summary data-zh="全部 7 篇乐理文章" data-en="All 7 music theory articles">全部 7 篇乐理文章</summary><ul>{resources.map(d=><li><a href={`/read/${d.slug}/`}>{d.title}<span>↗</span></a></li>)}</ul></details></div>
    </section>

    <section class="contact-section section-pad"><div class="contact-top reveal"><p class="eyebrow">A CONVERSATION STARTS SOMETHING.</p><a href="https://github.com/1eez" target="_blank" rel="noreferrer">GITHUB ↗</a></div><button type="button" class="contact-title reveal" data-qr="/media/images/wechat-personal.jpg" data-title="WeChat / 微信" aria-haspopup="dialog" aria-controls="qr-dialog"><span data-zh="聊聊新的可能。" data-en="Let’s talk possibilities.">聊聊新的可能。</span><span class="contact-arrow">↗</span></button><div class="contact-bottom"><a href="mailto:cnpro@163.com">cnpro@163.com</a><button class="qr-link" data-qr="/media/images/wechat-personal.jpg" data-title="WeChat / 微信" data-zh="微信联系 ↗" data-en="Connect on WeChat ↗">微信联系 ↗</button><span data-zh="保持好奇，持续创造。" data-en="Stay curious. Keep creating.">保持好奇，持续创造。</span></div></section>
  </main>
</Shell>

<script>
  import '../lib/lorenz-controls';
</script>
