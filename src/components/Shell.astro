---
import '../styles/global.css';
import '../styles/portfolio.css';
import Wordmark from './Wordmark.astro';
const { title = 'AI 应用、金融科技产品经理与项目经理 — Lord Li', description = '面向猎头、企业招聘与人才机构的产品经理、项目经理个人履历与作品集。结合 AI 应用、金融科技、产品设计与跨团队交付经验，持有 PMP、PRINCE2 认证及金融管理硕士学位。欢迎沟通岗位与合作机会。' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site!);
const profile = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lord Li',
  url: new URL('/', Astro.site!).href,
  image: new URL('/media/images/myphoto-transparent.png', Astro.site!).href,
  sameAs: ['https://github.com/1eez'],
  knowsAbout: ['AI 应用', '金融科技', '产品管理', '项目管理', '产品设计', 'Python', 'R'],
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Lord Li · 产品与项目实践" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={profile.image} />
    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(profile)} />}
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" href="/media/images/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="site-header">
      <a href="/" class="wordmark" aria-label="Lord Li 首页"><Wordmark /></a>
      <nav id="navigation" aria-label="主导航">
        <a href="/#about" data-zh="关于我" data-en="About">关于我</a>
        <a href="/work/" data-zh="作品" data-en="Work">作品</a>
        <a href="/#thinking" data-zh="产品理念" data-en="Product">产品理念</a>
        <a href="/#management" data-zh="项目管理" data-en="Projects">项目管理</a>
        <a href="/#programming" data-zh="编程" data-en="Code">编程</a>
        <a href="/#resources" data-zh="公用素材" data-en="Resources">公用素材</a>
      </nav>
      <div class="header-tools">
        <button class="search-trigger" aria-label="打开全站搜索"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.6"/></svg><kbd>⌘ K</kbd></button>
        <button id="locale-toggle" class="locale-toggle" aria-label="Switch to English" hidden={!['/', '/work', '/work/', '/read/index', '/read/index/', '/read/about/skills', '/read/about/skills/'].includes(Astro.url.pathname)}>EN <span>↗</span></button>
        <button class="menu-toggle" aria-label="展开导航" aria-expanded="false" aria-controls="navigation"><span></span><span></span></button>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="wordmark" href="/" aria-label="Lord Li 首页"><Wordmark /></a>
      <p>© {new Date().getFullYear()} Lord Li</p>
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">粤ICP备16037781号</a>
      <a href="#" class="back-top" data-zh="回到顶部 ↑" data-en="Back to top ↑">回到顶部 ↑</a>
    </footer>
    <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
      <div class="dialog-header"><h2 id="search-title" data-zh="探索整个网站" data-en="Explore the site">探索整个网站</h2><button class="dialog-close" aria-label="关闭搜索">✕</button></div>
      <label class="search-field"><span aria-hidden="true">⌕</span><input type="search" id="site-search" placeholder="搜索文章、作品、想法…" autocomplete="off" aria-label="搜索内容" /></label>
      <p class="search-status" role="status">输入关键词，发现产品、管理、编程与乐理内容。</p>
      <div class="search-results"></div>
      <div class="search-footer">全文搜索 <span>ESC 关闭</span></div>
    </dialog>
    <dialog id="qr-dialog" class="qr-dialog" aria-labelledby="qr-title"><button class="dialog-close" aria-label="关闭二维码">✕</button><p class="eyebrow">OPEN IN WECHAT</p><h2 id="qr-title"></h2><img id="qr-image" alt="微信二维码" width="344" height="344"/><p data-zh="使用微信扫一扫，或保存图片后识别。" data-en="Scan with WeChat, or save and recognize the image.">使用微信扫一扫，或保存图片后识别。</p><a id="qr-original" class="text-link" target="_blank" rel="noopener noreferrer" data-zh="查看原图 ↗" data-en="Original image ↗">查看原图 ↗</a><a id="qr-download" class="text-link" download data-zh="保存二维码 ↗" data-en="Save QR code ↗">保存二维码 ↗</a></dialog>
    <script>
      import '../lib/interactions';
    </script>
  </body>
</html>
